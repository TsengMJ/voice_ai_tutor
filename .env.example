# Copy to .env and fill in the four REQUIRED values. Everything else has a working default.

# --- REQUIRED ---------------------------------------------------------------

# LiveKit Cloud project (https://cloud.livekit.io -> Settings -> Keys).
# Also pays for the tutor's speech-to-text, LLM and text-to-speech via LiveKit Inference.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Google AI Studio key with Gemini access (https://aistudio.google.com/apikey).
# Used only by the API for hints and end-of-session feedback.
GOOGLE_API_KEY=

# Signs the anonymous learner cookie. Any random string of 16+ characters.
COOKIE_SECRET=replace-me-with-a-long-random-string

# --- OPTIONAL ---------------------------------------------------------------

# Show a labeled sample practice history so the dashboard is not empty on first run.
# Set to false to start every visitor with a clean slate.
SEED_DEMO=true

# Tutor voice pipeline (LiveKit Inference model strings): speech-to-text -> LLM -> text-to-speech.
STT_MODEL=deepgram/flux-general-multi
LLM_MODEL=google/gemini-2.5-flash
TTS_MODEL=cartesia/sonic-3
TTS_VOICE=9626c31c-bec5-4cca-baa8-f8ba9e84c8bc

# Click-time hints. Flash-lite with minimal thinking stays under a second; the text model does not.
GEMINI_HINT_MODEL=gemini-3.5-flash-lite

# End-of-session feedback. Not on the hint click path.
GEMINI_TEXT_MODEL=gemini-2.5-flash

# Explicit-dispatch name shared by the API and the agent worker.
AGENT_NAME=voice-tutor

# Host port for the web app. If you change it, update CORS_ORIGIN to match.
WEB_PORT=3000
CORS_ORIGIN=http://localhost:3000

# Set to true when serving over HTTPS so the learner cookie is marked Secure.
COOKIE_SECURE=false

# Password for the bundled Postgres container.
POSTGRES_PASSWORD=tutor

# docker compose injects these into the containers. Do not set them here:
# REDIS_URL, DATABASE_URL, PORT, NODE_ENV.
# FLUSH_INTERVAL_MS defaults to 15000. MIGRATIONS_DIR defaults to db/migrations.
